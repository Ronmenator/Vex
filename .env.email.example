# Email Monitor Configuration
# Copy this to .env and fill in your credentials

# ── Telegram ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Gmail ──
GMAIL_EMAIL=ronnie@ronniebarnard.com
GMAIL_CREDENTIALS_FILE=~/.gmail_creds.json

# ── Office 365 Accounts ──
# fzzy.ai
OFFICE365_EMAIL_FZZY=ronnie@fzzy.ai
OFFICE365_TENANT_FZZY=your_tenant_id_here
OFFICE365_CLIENT_ID_FZZY=your_client_id_here
OFFICE365_CLIENT_SECRET_FZZY=your_client_secret_here

# sopliance.com
OFFICE365_EMAIL_SOPLIANCE=ronnie@sopliance.com
OFFICE365_TENANT_SOPLIANCE=your_tenant_id_here
OFFICE365_CLIENT_ID_SOPLIANCE=your_client_id_here
OFFICE365_CLIENT_SECRET_SOPLIANCE=your_client_secret_here

# infogility.ai
OFFICE365_EMAIL_INFOGILITY=ronnie@infogility.ai
OFFICE365_TENANT_INFOGILITY=your_tenant_id_here
OFFICE365_CLIENT_ID_INFOGILITY=your_client_id_here
OFFICE365_CLIENT_SECRET_INFOGILITY=your_client_secret_here

# ── Options ──
EMAIL_LOG_LEVEL=INFO
EMAIL_CHECK_INTERVAL_MINUTES=10